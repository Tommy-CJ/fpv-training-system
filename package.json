{
  "name": "fpv-training-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node scripts/dev.js",
    "dev:vite": "vite",
    "server": "node server.js",
    "build": "vite build",
    "lint": "eslint .",
    "verify:bracket-core": "node scripts/verify-bracket-core.mjs",
    "verify:event-frequency": "node scripts/verify-event-frequency.mjs && node scripts/verify-event-page-render.mjs",
    "verify:training-live": "node scripts/verify-training-timeline-index.mjs && node scripts/verify-training-live.mjs",
    "verify:monitor-restore": "node scripts/verify-monitor-restore.mjs",
    "verify:live-load": "node scripts/benchmark-live-ingest.mjs 16 4000",
    "verify:virtual-receiver": "node scripts/verify-virtual-receiver.mjs",
    "verify:serial-port-claim": "node scripts/verify-serial-port-claim.mjs",
    "verify:serial-json-stream": "node scripts/verify-serial-json-stream.mjs && node scripts/verify-worker-live-transport.mjs",
    "virtual:receiver": "node scripts/virtual-receiver-array.mjs",
    "verify:ground-station": "node scripts/verify-ground-station-schema.mjs && node scripts/verify-ground-station-presets.mjs && node scripts/verify-ground-station-fleet.mjs && node scripts/verify-ground-station-states.mjs && node scripts/verify-ground-station-semantics.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "express": "^5.2.1",
    "jose": "^6.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  }
}
